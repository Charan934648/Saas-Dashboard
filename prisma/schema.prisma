datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

generator client {
  provider = "prisma-client-js"
}

model Tenant {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  vehicles  Vehicle[]
  users     User[]
  bookings  Booking[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String
  role      String   // "SUPER_ADMIN", "OWNER", "OPERATOR"
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Vehicle {
  id           String      @id @default(uuid())
  make         String
  model        String
  year         Int
  dailyRate    Float
  status       String      // "AVAILABLE", "RENTED", "MAINTENANCE"
  licensePlate String
  image        String
  fuelLevel    Int         // 0 - 100
  speed        Int         // current speed in km/h
  rpm          Int         // current RPM
  engineTemp   Int         // in Celsius
  gForce       Float       // G-force metric
  latitude     Float
  longitude    Float
  tenantId     String
  tenant       Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telemetry    Telemetry[]
  bookings     Booking[]
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
}

model Telemetry {
  id         String   @id @default(uuid())
  vehicleId  String
  vehicle    Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  timestamp  DateTime @default(now())
  speed      Int
  rpm        Int
  gForce     Float
  engineTemp Int
  fuelLevel  Int
}

model Booking {
  id           String   @id @default(uuid())
  vehicleId    String
  vehicle      Vehicle  @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  customerName String
  startDate    DateTime
  endDate      DateTime
  totalAmount  Float
  status       String   // "ACTIVE", "COMPLETED", "CANCELLED"
  createdAt    DateTime @default(now())
}
